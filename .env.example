# Supabase (Settings → API'de bulunur)
# Erken erişim formu için gerekli. Kurulum: supabase/schema.sql'i
# Supabase dashboard → SQL Editor'da bir kere çalıştır, sonra bu iki
# değeri .env.local'e (bu dosyayı KOPYALAYIP) yapıştır.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key — gizli, asla NEXT_PUBLIC_ önekiyle kullanma
SUPABASE_SERVICE_ROLE_KEY=

# Google ile giriş (admin panel) için gerekli — tarayıcıya gidecek public
# değerler, bu yüzden NEXT_PUBLIC_ önekli. Aynı Settings → API sayfasında:
# NEXT_PUBLIC_SUPABASE_URL = SUPABASE_URL ile aynı değer
# NEXT_PUBLIC_SUPABASE_ANON_KEY = "anon" / "publishable" key (service_role DEĞİL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
