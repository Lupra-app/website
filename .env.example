# ----------------------------------------------------------------------------
# Kurulum sırası
#
#   1. Bu dosyayı .env.local olarak kopyala ve aşağıdaki değerleri doldur
#      (Supabase → Settings → API).
#   2. supabase/schema.sql'i Supabase dashboard → SQL Editor'da bir kere
#      çalıştır (tablolar, indexler ve son-yönetici trigger'ı).
#   3. Kendi Google e-postanı yönetici listesine ekle — panele ilk giriş
#      ancak bundan sonra mümkün:
#
#         insert into admin_users (email) values (lower('senin@gmail.com'))
#         on conflict (email) do nothing;
#
#      Sonraki yöneticileri panelden ekleyebilirsin (/admin/admins).
# ----------------------------------------------------------------------------

# Sunucu tarafı. Admin panelinin tüm okumaları bu anahtarla yapılır
# (tablolarda RLS açık ve policy yok — detay: CLAUDE.md).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key — gizli, asla NEXT_PUBLIC_ önekiyle kullanma
SUPABASE_SERVICE_ROLE_KEY=

# Google ile giriş (admin panel) için gerekli — tarayıcıya gidecek public
# değerler, bu yüzden NEXT_PUBLIC_ önekli. Aynı Settings → API sayfasında:
# NEXT_PUBLIC_SUPABASE_URL = SUPABASE_URL ile aynı değer
# NEXT_PUBLIC_SUPABASE_ANON_KEY = "anon" / "publishable" key (service_role DEĞİL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
